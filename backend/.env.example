# ==============================================================================
# S/LAB FastAPI Backend Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NEON POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
# Paste your Neon Database Connection String (from Neon Console > Connection Details)
# Example: postgresql://neondb_owner:npg_xyz@ep-plain-tree-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://your_user:your_password@ep-your-neon-host.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. EMAIL NOTIFICATIONS (Choose Option A: Resend OR Option B: SMTP)
# ------------------------------------------------------------------------------
# Destination email address where you want to receive new contact transmissions
NOTIFICATION_EMAIL=your-personal-email@gmail.com

# --- OPTION A: RESEND (Recommended, easiest setup) ---
# Sign up at https://resend.com, grab an API Key, and paste here:
RESEND_API_KEY=re_123456789_abcdef
RESEND_FROM_EMAIL=S/LAB Signal <onboarding@resend.dev>

# --- OPTION B: STANDARD SMTP (e.g. Gmail App Password) ---
# For Gmail: Use an App Password (https://myaccount.google.com/apppasswords)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your_16_char_app_password

# ------------------------------------------------------------------------------
# 3. CORS & HOST CONFIGURATION
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://portfolio-iu86.onrender.com
HOST=0.0.0.0
PORT=8000
