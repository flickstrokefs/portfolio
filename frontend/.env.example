# ==============================================================================
# S/LAB Next.js Frontend Environment Variables
# ==============================================================================

# Public API URL used by the browser to fetch profile, projects, academic dossier, etc.
# Local Development: http://localhost:8000
# Production (Render / Railway / Fly.io / Custom Domain): https://your-fastapi-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side API URL used by Next.js Server Route Handler (/api/contact) to forward transmissions
# If omitted, will automatically fall back to NEXT_PUBLIC_API_URL
BACKEND_API_URL=http://localhost:8000
